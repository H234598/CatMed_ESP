# Local output and dependency downloads
/build*/
firmware/build*
firmware/managed_components/
firmware/sdkconfig*
!firmware/sdkconfig.defaults*
__pycache__/
*.pyc
# Backups may contain Wi-Fi credentials and are deliberately never versioned.
/private-backups/
# Local Vault reports are never part of the public repository.
/Reports/
/.local/
.env
.env.*

# Firmware, filesystem and diagnostic output stay local.
*.elf
*.map
*.log
*.bin
/core
