CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/c3.partitions.csv"
# Full-stack UI + Mesh + Web resource profile. Official SDK flash placement
# recovers shared INTERNAL|8BIT SRAM; the matched RX buffer/window pair keeps
# AMPDU enabled with a documented throughput tradeoff. Runtime latency and heap
# headroom must still be validated; retained sdkconfig must match the policy.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_RX_BA_WIN=2
# Two HTTP servers need six persistent SDK sockets; retain room for their
# concurrent client slots and the normal network services.
CONFIG_LWIP_MAX_SOCKETS=12
