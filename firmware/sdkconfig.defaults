CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
# Compiled Mesh/history-write path: 9824 B plus at least 1024 B headroom.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=11264
# Mesh software-timer formatting path: 1904 B plus 1024 B headroom.
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3072
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_MEM_SIZE=34816
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_ESP_TLS_SERVER_MIN_AUTH_MODE_OPTIONAL=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y
CONFIG_BRIDGE_DATA_FORWARDING_NETIF_SOFTAP=y
CONFIG_MESH_LITE_ENABLE=y
CONFIG_BRIDGE_EXTERNAL_NETIF_STATION=y
# Ethernet is absent from these boards and outside the mesh-only scope.
# CONFIG_BRIDGE_ETHERNET_NETIF_ENABLE is not set
