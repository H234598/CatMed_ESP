@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/* One bounded C3 diagnostic on the pinned esp_lvgl_port 2.9.0 build. */
+#ifndef ESP_LVGL_PORT_C3_ALARM_PROBE_H
+#define ESP_LVGL_PORT_C3_ALARM_PROBE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "lvgl.h"
+
+typedef enum {
+    LVGL_C3_ALARM_PROBE_UNUSED = 0,
+    LVGL_C3_ALARM_PROBE_ARMED,
+    LVGL_C3_ALARM_PROBE_PREPARING,
+    LVGL_C3_ALARM_PROBE_PENDING,
+    LVGL_C3_ALARM_PROBE_COMPLETED,
+    LVGL_C3_ALARM_PROBE_UNKNOWN,
+} lvgl_c3_alarm_probe_state_t;
+
+typedef enum {
+    LVGL_C3_ALARM_PIXEL_UNOBSERVED = 0,
+    LVGL_C3_ALARM_PIXEL_COMPATIBLE_OR_UNKNOWN,
+    LVGL_C3_ALARM_PIXEL_OUTSIDE_FILL_HULL,
+} lvgl_c3_alarm_pixel_class_t;
+
+typedef struct {
+    lvgl_c3_alarm_probe_state_t state;
+    lvgl_c3_alarm_pixel_class_t pixel_class;
+    uint16_t phase_permyriad;
+    bool phase_valid;
+    bool sample_valid;
+    bool completion_valid;
+} lvgl_c3_alarm_probe_result_t;
+
+/* Call after each C3 alarm UI render under the existing LVGL lock. A second
+ * render before the first matching flush invalidates the original phase. */
+void lvgl_port_c3_alarm_probe_render_step(lv_display_t *display, bool eligible,
+                                           uint16_t phase_permyriad,
+                                           uint16_t expected_rgb565);
+
+/* Task-context snapshot. No raw pixel, buffer pointer or IO handle escapes. */
+bool lvgl_port_c3_alarm_probe_snapshot(lvgl_c3_alarm_probe_result_t *out);
+
+#endif
