+++ b/src/lvgl9/esp_lvgl_port_c3_alarm_probe.c
@@ -0,0 +1,173 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/* Pinned, one-shot C3 alarm diagnostic for esp_lvgl_port 2.9.0.
+ * The IO callback remains owned by esp_lvgl_port_disp.c. */
+#include "esp_lvgl_port_c3_alarm_probe_priv.h"
+#include "freertos/FreeRTOS.h"
+#include "esp_attr.h"
+#include <stddef.h>
+
+#define PROBE_X 5
+#define PROBE_Y 90
+#define PROBE_OPA 217u
+
+typedef struct {
+    lvgl_c3_alarm_probe_result_t result;
+    lv_display_t *display;
+    esp_lcd_panel_io_handle_t io;
+    uint16_t expected_rgb565;
+} C3AlarmProbe;
+
+static portMUX_TYPE probe_mux = portMUX_INITIALIZER_UNLOCKED;
+static C3AlarmProbe probe;
+
+static bool channel_possible(unsigned actual, unsigned intended, unsigned maximum)
+{
+    /* Deliberately wider than the RGB565 rounding error. An inside-hull value
+     * is never interpreted as proof that an alarm strip was drawn. */
+    const int low = (int)(intended * PROBE_OPA / 255u) - 4;
+    const int high = (int)((intended * PROBE_OPA + maximum *
+                            (255u - PROBE_OPA) + 254u) / 255u) + 4;
+    return (int)actual >= low && (int)actual <= high;
+}
+
+lvgl_c3_alarm_pixel_class_t lvgl_port_c3_alarm_probe_classify_pixel(
+    uint16_t actual, uint16_t expected)
+{
+    const bool possible =
+        channel_possible((actual >> 11) & 31u, (expected >> 11) & 31u, 31u) &&
+        channel_possible((actual >> 5) & 63u, (expected >> 5) & 63u, 63u) &&
+        channel_possible(actual & 31u, expected & 31u, 31u);
+    return possible ? LVGL_C3_ALARM_PIXEL_COMPATIBLE_OR_UNKNOWN :
+                      LVGL_C3_ALARM_PIXEL_OUTSIDE_FILL_HULL;
+}
+
+void lvgl_port_c3_alarm_probe_render_step(lv_display_t *display, bool eligible,
+                                           uint16_t phase_permyriad,
+                                           uint16_t expected_rgb565)
+{
+    portENTER_CRITICAL(&probe_mux);
+    if (probe.result.state == LVGL_C3_ALARM_PROBE_UNUSED && eligible && display) {
+        probe.display = display;
+        probe.expected_rgb565 = expected_rgb565;
+        probe.result.phase_permyriad = phase_permyriad;
+        probe.result.phase_valid = true;
+        probe.result.state = LVGL_C3_ALARM_PROBE_ARMED;
+    } else if (probe.result.state == LVGL_C3_ALARM_PROBE_ARMED) {
+        /* A second UI state reached the display before this one was sampled. */
+        probe.result.phase_valid = false;
+        probe.result.state = LVGL_C3_ALARM_PROBE_UNKNOWN;
+    }
+    portEXIT_CRITICAL(&probe_mux);
+}
+
+void lvgl_port_c3_alarm_probe_before_draw(lv_display_t *display,
+                                            esp_lcd_panel_io_handle_t io,
+                                            int x1, int y1, int x2, int y2,
+                                            const uint8_t *color_map,
+                                            bool swap_bytes,
+                                            bool orientation_zero)
+{
+    portENTER_CRITICAL(&probe_mux);
+    if (probe.result.state == LVGL_C3_ALARM_PROBE_PENDING &&
+        probe.display == display) {
+        probe.result.state = LVGL_C3_ALARM_PROBE_UNKNOWN;
+    } else if (probe.result.state == LVGL_C3_ALARM_PROBE_ARMED &&
+               probe.display == display &&
+               x1 <= PROBE_X && PROBE_X < x2 &&
+               y1 <= PROBE_Y && PROBE_Y < y2) {
+        const int width = x2 - x1;
+        const int height = y2 - y1;
+        if (!orientation_zero || !io || !color_map ||
+            width <= 0 || width > 240 || height <= 0 || height > 80) {
+            probe.result.phase_valid = false;
+            probe.result.state = LVGL_C3_ALARM_PROBE_UNKNOWN;
+        } else {
+            const size_t offset = ((size_t)(PROBE_Y - y1) * (size_t)width +
+                                   (size_t)(PROBE_X - x1)) * 2u;
+            /* No buffer pointer or raw pixel is stored. The port has already
+             * done its rotation/byte swap and has not queued this draw yet. */
+            const uint16_t pixel = swap_bytes ?
+                ((uint16_t)color_map[offset] << 8) | color_map[offset + 1u] :
+                ((uint16_t)color_map[offset + 1u] << 8) | color_map[offset];
+            probe.result.pixel_class = lvgl_port_c3_alarm_probe_classify_pixel(pixel,
+                                                       probe.expected_rgb565);
+            probe.result.sample_valid = true;
+            probe.io = io;
+            probe.result.state = LVGL_C3_ALARM_PROBE_PREPARING;
+        }
+    } else if (probe.result.state == LVGL_C3_ALARM_PROBE_PREPARING &&
+               probe.display == display) {
+        probe.result.state = LVGL_C3_ALARM_PROBE_UNKNOWN;
+    }
+    portEXIT_CRITICAL(&probe_mux);
+}
+
+void lvgl_port_c3_alarm_probe_after_draw(lv_display_t *display,
+                                           esp_lcd_panel_io_handle_t io,
+                                           esp_err_t result)
+{
+    portENTER_CRITICAL(&probe_mux);
+    if (probe.result.state == LVGL_C3_ALARM_PROBE_PREPARING &&
+        probe.display == display && probe.io == io) {
+        probe.result.state = result == ESP_OK ? LVGL_C3_ALARM_PROBE_PENDING :
+                                                LVGL_C3_ALARM_PROBE_UNKNOWN;
+    }
+    portEXIT_CRITICAL(&probe_mux);
+}
+
+esp_err_t lvgl_port_c3_alarm_probe_draw(lv_display_t *display,
+    esp_lcd_panel_io_handle_t io, esp_lcd_panel_handle_t panel,
+    int x1, int y1, int x2, int y2, uint8_t *color_map,
+    bool swap_bytes, bool orientation_zero)
+{
+    lvgl_port_c3_alarm_probe_before_draw(display, io, x1, y1, x2, y2,
+                                          color_map, swap_bytes,
+                                          orientation_zero);
+    const esp_err_t result = esp_lcd_panel_draw_bitmap(panel, x1, y1,
+                                                        x2, y2, color_map);
+    lvgl_port_c3_alarm_probe_after_draw(display, io, result);
+    return result;
+}
+
+void IRAM_ATTR lvgl_port_c3_alarm_probe_color_done(lv_display_t *display,
+                                          esp_lcd_panel_io_handle_t io)
+{
+    /* This ISR-capable path only compares fixed fields under the existing
+     * FreeRTOS spinlock. It does not allocate, wait, log or touch DMA data. */
+    portENTER_CRITICAL_ISR(&probe_mux);
+    if (probe.result.state == LVGL_C3_ALARM_PROBE_PREPARING ||
+        probe.result.state == LVGL_C3_ALARM_PROBE_PENDING ||
+        probe.result.state == LVGL_C3_ALARM_PROBE_COMPLETED) {
+        if (probe.result.state == LVGL_C3_ALARM_PROBE_PENDING &&
+            probe.display == display && probe.io == io) {
+            probe.result.completion_valid = true;
+            probe.result.state = LVGL_C3_ALARM_PROBE_COMPLETED;
+        } else {
+            probe.result.completion_valid = false;
+            probe.result.state = LVGL_C3_ALARM_PROBE_UNKNOWN;
+        }
+    }
+    portEXIT_CRITICAL_ISR(&probe_mux);
+}
+
+void lvgl_port_c3_alarm_probe_display_removed(lv_display_t *display)
+{
+    portENTER_CRITICAL(&probe_mux);
+    if (probe.display == display) {
+        probe.display = NULL;
+        probe.io = NULL;
+        probe.result.phase_valid = false;
+        probe.result.completion_valid = false;
+        probe.result.state = LVGL_C3_ALARM_PROBE_UNKNOWN;
+    }
+    portEXIT_CRITICAL(&probe_mux);
+}
+
+bool lvgl_port_c3_alarm_probe_snapshot(lvgl_c3_alarm_probe_result_t *out)
+{
+    if (!out) return false;
+    portENTER_CRITICAL(&probe_mux);
+    *out = probe.result;
+    portEXIT_CRITICAL(&probe_mux);
+    return true;
+}
